<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HssBackdropPoc.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HssBackdropPoc"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="286" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Opaque shell regions intentionally mask the native backdrop. -->
        <Border Grid.RowSpan="2" Background="#FF171A1F" />
        <StackPanel Grid.RowSpan="2" Margin="28,32,20,24" Spacing="28">
            <TextBlock Text="◈  FRAME" Foreground="#FFF2F4F7" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="⌂   Home" Foreground="#FFD8DDE4" FontSize="15" />
            <TextBlock Text="▣   Library" Foreground="#FF9EA6B1" FontSize="15" />
            <TextBlock Text="⚙   Settings" Foreground="#FF9EA6B1" FontSize="15" VerticalAlignment="Bottom" />
        </StackPanel>

        <Grid Grid.Column="1" Grid.Row="0" Background="#FF0B0D11">
            <StackPanel Margin="48,54,40,32" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="THE LAST SIGNAL" Foreground="#FFF4F5F7" FontSize="40" FontWeight="SemiBold" />
                <TextBlock Text="98% match   ·   2024   ·   1h 52m   ·   Sci-fi drama"
                           Foreground="#FFB8C0CA" FontSize="14" />
                <TextBlock Text="Opaque hero — the native backdrop should not leak through here."
                           Foreground="#FFB8C0CA" FontSize="14" />
            </StackPanel>
        </Grid>

        <!-- Side-by-side HSS halves: native XAML proves the element backdrop;
             WebView2 reveals whether browser alpha survives XAML composition. -->
        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <SystemBackdropElement x:Name="NativeBackdrop" Grid.ColumnSpan="2" CornerRadius="0">
                <SystemBackdropElement.SystemBackdrop>
                    <DesktopAcrylicBackdrop />
                </SystemBackdropElement.SystemBackdrop>
            </SystemBackdropElement>

            <Grid Grid.Column="0">
                <StackPanel Margin="40" Spacing="12" VerticalAlignment="Top">
                    <TextBlock Text="HSS · Native XAML"
                               Foreground="#FFF4F5F7" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="This half tests Desktop Acrylic in a bounded native XAML region."
                               Foreground="#FFD3D8DF" FontSize="14" TextWrapping="Wrap" />
                    <TextBlock x:Name="NativeDiagnostic"
                               Text="Checking OS Acrylic support…"
                               Foreground="#FFB8C0CA" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1">
                <WebView2 x:Name="HssWebContent"
                          DefaultBackgroundColor="#00000000"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
            </Grid>
        </Grid>
    </Grid>
</Page>

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media Library",
  "version": "0.1.0",
  "identifier": "local.media.platform",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Media Library",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self' customprotocol: asset:; script-src 'self' https://www.youtube.com; img-src 'self' asset: http://asset.localhost https://images.unsplash.com https://image.tmdb.org https://static.tvmaze.com data:; media-src 'self' asset: http://asset.localhost; frame-src https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.tvmaze.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../native/libtorrent-bridge/build/Release/media_libtorrent_bridge.dll": "torrent-engine/media_libtorrent_bridge.dll"
    },
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}

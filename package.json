{
	"name": "media-platform-desktop",
	"private": true,
	"version": "0.1.3",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"media-server:test": "npm --prefix media-server test",
		"build": "vite build",
		"desktop:prepare": "node scripts/prepare-windows.mjs",
		"desktop:dev": "npm run desktop:prepare && tauri dev",
		"desktop:dev:independent": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev-independent.ps1",
		"mobile:preview": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-mobile-preview.ps1",
		"desktop:build": "npm run desktop:prepare && tauri build",
		"desktop:info": "tauri info",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tauri-apps/cli": "^2.11.5",
		"@types/node": "^22.20.5",
		"7zip-bin": "5.2.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.3",
		"lenis": "1.3.26",
		"phosphor-svelte": "^3.1.0"
	}
}
